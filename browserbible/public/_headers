# Security and caching headers for the deployed app.
#
# This file is the Cloudflare Pages / Netlify convention and is copied into
# dist/ by the build. If the site is served by nginx/Apache/other, translate
# these into that server's config instead (the header names/values are the same).
#
# The Content-Security-Policy is injected into index.html as a <meta> tag at
# build time (see vite.config.js injectCsp), so it is enforced even on hosts
# that ignore this file. The headers below are the ones a <meta> tag cannot set.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Caching.
#
# Deliberately no Cache-Control in the /* block above: every matching rule is
# applied and same-named headers are combined, so a global Cache-Control would
# collide with the per-path values below instead of being overridden by them.
# For the same reason no two rules below may match the same file.
#
# Everything Vite emits is content-hashed (see rolldownOptions.output in
# vite.config.js), so those directories cache for a year and a deploy busts
# them by changing the filename. index.html is the unhashed entry point that
# names them, so it must revalidate on every load; if it were cached, a deploy
# would not reach returning visitors. The remaining unhashed files are copied
# verbatim from public/ and get a plain max-age instead.

# The document that references every hashed name. Never cache it.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Content-hashed build output: entry chunk, lazy chunks, bundled CSS, and any
# image/font/asset Vite emitted for them.
/js/chunks/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed files copied from public/. Their bytes can change without their
# names changing, so they revalidate on a timer rather than caching immutably.

# i18n strings. Kept out of the immutable rule above by living in
# js/resources/ rather than js/chunks/.
/js/resources/*
  Cache-Control: public, max-age=3600

# App icons and logos, referenced by fixed name from index.html,
# manifest.webmanifest, and the main menu. Their bytes rarely change, but the
# names never do, so a long max-age would strand a replaced icon in caches for
# weeks. Kept at an hour like the other unhashed files.
/img/*
  Cache-Control: public, max-age=3600

# Bundled data (maps, parallels, media manifests) ships with the build and
# changes with it, so keep this short enough that a deploy propagates quickly.
/content/*
  Cache-Control: public, max-age=3600
