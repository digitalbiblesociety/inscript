{
  "name": "BrowserBible",
  "version": "4.0.0",
  "type": "module",
  "description": "Bible software that runs in the browser.",
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalbiblesociety/browserbible-3"
  },
  "author": "John Dyer",
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "overrides": {
      "undici": "7.29.0"
    }
  },
  "scripts": {
    "dev": "pnpm run /^dev:/",
    "dev:app": "vite",
    "dev:proxy": "pnpm --dir proxy dev",
    "build": "SITE=inscript vite build",
    "build:dev": "SITE=dev vite build",
    "build:inscript": "SITE=inscript vite build",
    "build:cf": "vite build",
    "preview": "vite preview",
    "preview:cf": "pnpm dlx wrangler pages dev browserbible/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm test:coverage:unit && pnpm test:coverage:e2e && nyc report",
    "test:coverage:unit": "vitest run --coverage",
    "test:coverage:e2e": "VITE_COVERAGE=true playwright test --project=chromium-remote --project=chromium-local",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "fetch-starter-pack": "node tests/scripts/fetch-starter-pack.mjs",
    "repair-starter-pack": "node tests/scripts/repair-starter-pack.mjs",
    "demo": "node tools/demo-walkthrough.mjs",
    "build-basemap": "node tools/build-basemap.mjs",
    "build-dbs-video-media": "node tools/build-dbs-video-media.mjs",
    "lint": "eslint browserbible/js",
    "lint:fix": "eslint browserbible/js --fix",
    "vd:dev": "vite --config verse-detection/vite.config.js serve verse-detection",
    "vd:build": "vite --config verse-detection/vite.config.ts build && vite --config verse-detection/vite.config.auto.ts build",
    "vd:preview": "vite --config verse-detection/vite.config.js preview verse-detection",
    "knip": "knip"
  },
  "dependencies": {
    "@browserbible/verse-detection": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "browserslist": "^4.28.7",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-source-maps": "^5.0.6",
    "jsdom": "^29.1.1",
    "knip": "^6.31.0",
    "lightningcss": "^1.33.0",
    "nyc": "^18.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.1.10"
  }
}
